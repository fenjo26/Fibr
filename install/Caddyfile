# Fibr edge: TLS termination, static admin/mini app, API reverse proxy.
# Set FIBR_DOMAIN to your domain (e.g. vpn.example.com) — Caddy issues a
# Let's Encrypt certificate automatically. For local dev set
# FIBR_DOMAIN=http://localhost to serve plain HTTP without TLS.

{$FIBR_DOMAIN} {
	# VLESS over XHTTP (docs/xray.md): the secret path goes to the xray
	# container's XHTTP inbound. It rides on this site's own certificate on
	# :443, so to a filtering network it is the same HTTPS as the cabinet.
	# Never compress or buffer it: the tunnel streams.
	@xhttp path {$FIBR_XHTTP_PATH:/fibr-xh} {$FIBR_XHTTP_PATH:/fibr-xh}/*
	@notxhttp not path {$FIBR_XHTTP_PATH:/fibr-xh} {$FIBR_XHTTP_PATH:/fibr-xh}/*
	encode @notxhttp zstd gzip

	handle @xhttp {
		reverse_proxy h2c://xray:10086 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy fibr:8080
	}

	# Quick-connect landing pages (https://<domain>/join/<code>): rendered by
	# the API container; the page itself never consumes the code.
	handle /join/* {
		reverse_proxy fibr:8080
	}

	# Client binaries dropped into /opt/fibr/download (see sync-downloads.sh).
	# `browse` renders a simple listing so Android TV's Downloader app users
	# can also navigate to the file when they forget the exact name.
	handle /download/* {
		root * /srv
		file_server browse
	}

	# Short download links people can type: on a TV remote (Downloader app)
	# and in a phone browser alike. They 302 to the stable release asset name.
	redir /tv.apk /download/Fibr-Android.apk 302
	redir /app.apk /download/Fibr-Android.apk 302
	redir /windows.zip /download/Fibr-Windows.zip 302
	redir /macos.zip /download/Fibr-macOS.zip 302

	# The web frontends are small static files that change with every deploy;
	# Telegram's webview caches aggressively, and a stale app.js against a
	# fresh index.html renders as a black screen. Ask for revalidation.
	@frontend path /miniapp/* /admin/* /cabinet/* /shared/*
	header @frontend Cache-Control "no-cache"

	handle {
		root * /srv
		redir / /miniapp/ 302
		file_server
	}

	log {
		output stdout
		format console
	}
}
