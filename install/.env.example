# Fibr server configuration. install.sh copies this to .env and fills secrets;
# never commit the real .env.

# Public domain (also used as the WireGuard endpoint host unless overridden).
FIBR_DOMAIN=example.com

# Internal API listen address; Caddy proxies to it. Usually unchanged.
FIBR_API_ADDR=:8080

# Persistent state (database + server key) — docker volume /data.
FIBR_DATA_DIR=/data

# WireGuard.
FIBR_WG_IFACE=wg0
FIBR_WG_PORT=51820
#FIBR_WG_HOST=            # defaults to FIBR_DOMAIN
FIBR_SUBNET=10.8.0.0/24
FIBR_DNS=1.1.1.1,1.0.0.1
FIBR_MTU=1420
FIBR_STATS_INTERVAL=30s
FIBR_MAX_DEVICES=10

# Secrets — generated by install.sh.
FIBR_ADMIN_TOKEN=change-me
FIBR_SECRET=change-me

# Telegram (optional but needed for the bot and Mini App login).
# 1) @BotFather -> /newbot -> copy the token here.
# 2) @BotFather -> /mybots -> your bot -> Bot Settings -> Menu Button -> set https://<domain>/miniapp/
# 3) Add your own Telegram numeric id below to get admin rights via Telegram.
FIBR_TELEGRAM_BOT_TOKEN=
FIBR_ADMIN_TELEGRAM_IDS=
