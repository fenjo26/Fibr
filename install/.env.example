# Fibr server configuration. install.sh copies this to .env and fills secrets;
# never commit the real .env.

# Public domain (also used as the WireGuard endpoint host unless overridden).
FIBR_DOMAIN=example.com

# Internal API listen address; Caddy proxies to it. Usually unchanged.
FIBR_API_ADDR=:8080

# Persistent state (database + server key) — docker volume /data.
FIBR_DATA_DIR=/data

# WireGuard.
# Engine: kernel (in-kernel module, default) or awg — AmneziaWG, DPI-obfuscated
# WireGuard served by the bundled amneziawg-go userspace daemon. awg mode is a
# whole-server switch: ALL wg devices then need AmneziaVPN client apps (the
# official WireGuard app cannot read AmneziaWG configs). See docs/awg.md.
FIBR_WG_ENGINE=kernel
FIBR_WG_IFACE=wg0
FIBR_WG_PORT=51820
#FIBR_WG_HOST=            # defaults to FIBR_DOMAIN
FIBR_SUBNET=10.8.0.0/24
FIBR_DNS=1.1.1.1,1.0.0.1
FIBR_MTU=1420
FIBR_STATS_INTERVAL=30s
FIBR_MAX_DEVICES=10

# Secrets — generated by install.sh.
FIBR_ADMIN_TOKEN=change-me
FIBR_SECRET=change-me

# Xray (VLESS + Reality) — optional second protocol for DPI resistance.
# Off by default; enable at install time with `install.sh --xray` or by hand:
#   1) set FIBR_XRAY_ENABLED=true and FIBR_XRAY_SNI below,
#   2) generate a short id:  openssl rand -hex 4   -> FIBR_XRAY_SHORT_ID,
#   3) uncomment COMPOSE_PROFILES=xray so the xray container starts,
#   4) docker compose up -d  (first enablement) .
# The Reality keypair is generated by the fibr server itself and stored in
# the database — nothing to configure here.
#
# NOTE: xray listens on TCP (it masquerades as TLS), not UDP.
# NOTE: after fibr changes xray devices it rewrites /data/xray/config.json,
# but xray reads it only at startup — apply changes manually:
#   docker compose -f /opt/fibr/install/docker-compose.yml restart xray
# (fibr intentionally has no access to the docker socket.)
FIBR_XRAY_ENABLED=false
FIBR_XRAY_PORT=8443
# Camouflage domain (SNI); REQUIRED when FIBR_XRAY_ENABLED=true.
# Pick a site that is reachable from your VPS, speaks TLS 1.3 + HTTP/2 and
# is not blocked in the networks your clients use.
FIBR_XRAY_SNI=www.microsoft.com
# Reality fallback destination; defaults to <FIBR_XRAY_SNI>:443.
#FIBR_XRAY_DEST=
# Reality short id — even-length hex, generated by install.sh (openssl rand -hex 4).
FIBR_XRAY_SHORT_ID=
# Uncomment to start the xray container (compose profile; kept in sync with
# FIBR_XRAY_ENABLED by install.sh).
#COMPOSE_PROFILES=xray

# Telegram (optional but needed for the bot and Mini App login).
# 1) @BotFather -> /newbot -> copy the token here.
# 2) @BotFather -> /mybots -> your bot -> Bot Settings -> Menu Button -> set https://<domain>/miniapp/
# 3) Add your own Telegram numeric id below to get admin rights via Telegram.
FIBR_TELEGRAM_BOT_TOKEN=
FIBR_ADMIN_TELEGRAM_IDS=
