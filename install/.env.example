# Fibr server configuration. install.sh copies this to .env and fills secrets;
# never commit the real .env.

# Public domain (also used as the WireGuard endpoint host unless overridden).
FIBR_DOMAIN=example.com

# Internal API listen address; Caddy proxies to it. Usually unchanged.
FIBR_API_ADDR=:8080

# Persistent state (database + server key) — docker volume /data.
FIBR_DATA_DIR=/data

# WireGuard.
# Engine: kernel (in-kernel module, default) or awg — AmneziaWG, DPI-obfuscated
# WireGuard served by the bundled amneziawg-go userspace daemon. awg mode is a
# whole-server switch: ALL wg devices then need AmneziaVPN client apps (the
# official WireGuard app cannot read AmneziaWG configs). See docs/awg.md.
FIBR_WG_ENGINE=kernel
FIBR_WG_IFACE=wg0
FIBR_WG_PORT=51820
#FIBR_WG_HOST=            # defaults to FIBR_DOMAIN
FIBR_SUBNET=10.8.0.0/24
# IPv6 ULA /64 for dual-stack tunnels; the device address is derived from
# its IPv4 (10.8.0.42 -> fd42:f1b2::2a). IPv6 egress is best-effort: hosts
# without IPv6 simply keep routing v4 only.
FIBR_SUBNET6=fd42:f1b2::/64
FIBR_DNS=1.1.1.1,1.0.0.1
# Protected DNS (docs/dns-games.md): the filtering resolver inside the
# container. Devices with a profile (default below) get
# "DNS = <tunnel gateway>" in their configs instead of FIBR_DNS.
FIBR_DNS_ENABLED=true
# off | adblock | family — applied to devices the owner did not touch.
FIBR_DNS_PROFILE_DEFAULT=adblock
# Upstream resolvers of the filtering resolver (DoH supported).
FIBR_DNS_UPSTREAM=https://1.1.1.1/dns-query,1.1.1.1
# Optional overrides of the builtin StevenBlack lists:
#FIBR_DNS_LISTS_ADBLOCK=
#FIBR_DNS_LISTS_ADULT=
# Game catalog for the app's game mode (/api/games).
FIBR_GAMES_ENABLED=true
FIBR_MTU=1420
FIBR_STATS_INTERVAL=30s
# Global default for devices per user. Personal limits (the "5-device
# package" idea) are set per user in the admin panel and cascade like
# expiry: a user's effective limit is the minimum of their own and their
# owner-admin's. See docs/devices.md.
FIBR_MAX_DEVICES=10

# Invite-only self-enrollment (stage 4): when true, a new Mini App user must
# present a one-time invite code (create links in the admin panel or via the
# bot's /invite command). Existing users sign in freely. See docs/self-enroll.md.
FIBR_REQUIRE_INVITE=false

# Secrets — generated by install.sh.
FIBR_ADMIN_TOKEN=change-me
FIBR_SECRET=change-me

# Xray (VLESS + Reality) — second protocol for DPI resistance, ON by
# default (users pick WireGuard or VLESS). Everything below has working
# defaults: the Reality keypair and short id are generated by the fibr
# server and stored in the database. Device changes apply live through
# xray's API. Open FIBR_XRAY_PORT/tcp in the firewall.
# NOTE: xray listens on TCP (it masquerades as TLS), not UDP.
FIBR_XRAY_ENABLED=true
FIBR_XRAY_PORT=8443
# Camouflage domain (SNI); REQUIRED when FIBR_XRAY_ENABLED=true.
# Pick a site that is reachable from your VPS, speaks TLS 1.3 + HTTP/2 and
# is not blocked in the networks your clients use.
FIBR_XRAY_SNI=www.microsoft.com
# Reality fallback destination; defaults to <FIBR_XRAY_SNI>:443.
#FIBR_XRAY_DEST=
# Reality short id — even-length hex; empty = generated by the server.
FIBR_XRAY_SHORT_ID=

# One-click updates from the admin panel (docs/updates.md) — opt-in:
#   install.sh --with-updater
# or by hand: add "updater" to the single COMPOSE_PROFILES line above (there
# must be only one), e.g.  COMPOSE_PROFILES=xray,updater  or just
# COMPOSE_PROFILES=updater , then  docker compose up -d .
# The updater sidecar listens ONLY inside the compose network (fibr reaches
# it at the address below; no published ports) and the trigger endpoint is
# admin-token-gated in fibr. TRADE-OFF: the updater container mounts
# /var/run/docker.sock, which is effectively root on the host — enable it
# only on a server you fully control. Nothing is automatic: no timers, the
# update runs only when the superadmin presses the button.
# Where fibr finds the sidecar (service name inside the compose network);
# change only for non-compose setups.
#FIBR_UPDATER_URL=http://updater:8912

# Telegram (optional but needed for the bot and Mini App login).
# 1) @BotFather -> /newbot -> copy the token here.
# 2) @BotFather -> /mybots -> your bot -> Bot Settings -> Menu Button -> set https://<domain>/miniapp/
# 3) Add your own Telegram numeric id below to get admin rights via Telegram.
FIBR_TELEGRAM_BOT_TOKEN=
FIBR_ADMIN_TELEGRAM_IDS=

# Extra node (fibr-node agent) — see docs/multinode.md. These live on the
# NODE machine's own .env next to docker-compose.node.yml, NOT here; listed
# for reference.
#FIBR_API_URL=https://vpn.example.com   # control plane address (this install)
#FIBR_NODE_TOKEN=                       # from admin panel -> Nodes -> Add node
#FIBR_WG_IFACE=wg0                      # interface name on the node
#FIBR_LISTEN_PORT=51820                 # node's public UDP port
#FIBR_SYNC_INTERVAL=20s                 # peer list pull cadence
#FIBR_AGENT_ADDR=:8081                  # local healthcheck listener (not published)
#FIBR_XRAY_ENABLED=true                 # also run the xray container on the node
#FIBR_XRAY_PORT=8443                    # node's public TCP port for xray
